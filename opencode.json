{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "engineering-lead",
  "model": "cliproxyapi/kimi-k2.7-code",
  "agents": {
    "solution-architect": { "model": "cliproxyapi/claude-sonnet-5-5" },
    "engineering-lead": { "model": "cliproxyapi/claude-sonnet-5-5" },
    "security-engineer": { "model": "cliproxyapi/claude-sonnet-5-5" }
  },
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git push *", "effect": "deny" },
    { "action": "shell", "resource": "git reset --hard *", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf *", "effect": "deny" },
    { "action": "shell", "resource": "docker compose down -v*", "effect": "deny" },
    { "action": "shell", "resource": "docker volume prune*", "effect": "deny" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "skill", "resource": "firecrawl-*", "effect": "deny" },
    { "action": "skill", "resource": "firecrawl", "effect": "allow" },
    { "action": "skill", "resource": "firecrawl-search", "effect": "allow" },
    { "action": "skill", "resource": "firecrawl-scrape", "effect": "allow" },
    { "action": "skill", "resource": "firecrawl-parse", "effect": "allow" }
  ],
  "formatter": true
}
