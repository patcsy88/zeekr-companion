{
  "description": "Shared test vectors for the warranty status rule (AC-51, AC-57). Used by pytest and Vitest. today is the Asia/Kuala_Lumpur date. current_odometer_km null means unknown. expiring_soon is at most 90 days or 5,000 km; equality with an end date or km limit is not expired.",
  "cases": [
    {"name": "today equals end date is not expired (expiring soon by date)", "today": "2026-10-22", "current_odometer_km": null, "coverage": {"start_date": "2021-10-22", "end_date": "2026-10-22", "km_limit": null}, "expected": {"status": "expiring_soon", "expired_by": [], "expiring_soon_by": ["date"]}},
    {"name": "day after end date is expired by date", "today": "2026-10-22", "current_odometer_km": null, "coverage": {"start_date": "2021-10-21", "end_date": "2026-10-21", "km_limit": null}, "expected": {"status": "expired", "expired_by": ["date"], "expiring_soon_by": []}},
    {"name": "odometer equals km limit is not expired (expiring soon by odometer)", "today": "2026-10-22", "current_odometer_km": 150000, "coverage": {"start_date": "2026-01-01", "end_date": null, "km_limit": 150000}, "expected": {"status": "expiring_soon", "expired_by": [], "expiring_soon_by": ["odometer"]}},
    {"name": "odometer one above km limit is expired by odometer", "today": "2026-10-22", "current_odometer_km": 150001, "coverage": {"start_date": "2026-01-01", "end_date": null, "km_limit": 150000}, "expected": {"status": "expired", "expired_by": ["odometer"], "expiring_soon_by": []}},
    {"name": "today before start is not started", "today": "2026-10-22", "current_odometer_km": null, "coverage": {"start_date": "2026-10-23", "end_date": "2031-10-23", "km_limit": null}, "expected": {"status": "not_started", "expired_by": [], "expiring_soon_by": []}},
    {"name": "today equals start date is not not_started", "today": "2026-10-22", "current_odometer_km": null, "coverage": {"start_date": "2026-10-22", "end_date": "2031-10-22", "km_limit": null}, "expected": {"status": "active", "expired_by": [], "expiring_soon_by": []}},
    {"name": "both limits, both passed", "today": "2026-10-22", "current_odometer_km": 160000, "coverage": {"start_date": "2020-01-01", "end_date": "2026-01-01", "km_limit": 150000}, "expected": {"status": "expired", "expired_by": ["date", "odometer"], "expiring_soon_by": []}},
    {"name": "both limits, only date passed", "today": "2026-10-22", "current_odometer_km": 1000, "coverage": {"start_date": "2020-01-01", "end_date": "2026-01-01", "km_limit": 150000}, "expected": {"status": "expired", "expired_by": ["date"], "expiring_soon_by": []}},
    {"name": "both limits, only odometer passed", "today": "2026-10-22", "current_odometer_km": 160000, "coverage": {"start_date": "2020-01-01", "end_date": "2030-01-01", "km_limit": 150000}, "expected": {"status": "expired", "expired_by": ["odometer"], "expiring_soon_by": []}},
    {"name": "both limits, far from both is active", "today": "2026-10-22", "current_odometer_km": 20000, "coverage": {"start_date": "2026-01-01", "end_date": "2031-01-01", "km_limit": 150000}, "expected": {"status": "active", "expired_by": [], "expiring_soon_by": []}},
    {"name": "both limits, soon by date and odometer", "today": "2026-10-22", "current_odometer_km": 146000, "coverage": {"start_date": "2021-11-01", "end_date": "2026-12-01", "km_limit": 150000}, "expected": {"status": "expiring_soon", "expired_by": [], "expiring_soon_by": ["date", "odometer"]}},
    {"name": "only end date, active", "today": "2026-10-22", "current_odometer_km": null, "coverage": {"start_date": "2026-01-01", "end_date": "2031-01-01", "km_limit": null}, "expected": {"status": "active", "expired_by": [], "expiring_soon_by": []}},
    {"name": "only km limit, active", "today": "2026-10-22", "current_odometer_km": 20000, "coverage": {"start_date": "2026-01-01", "end_date": null, "km_limit": 150000}, "expected": {"status": "active", "expired_by": [], "expiring_soon_by": []}},
    {"name": "only km limit, odometer unknown is active", "today": "2026-10-22", "current_odometer_km": null, "coverage": {"start_date": "2026-01-01", "end_date": null, "km_limit": 150000}, "expected": {"status": "active", "expired_by": [], "expiring_soon_by": []}},
    {"name": "odometer unknown skips km even with km limit near", "today": "2026-10-22", "current_odometer_km": null, "coverage": {"start_date": "2026-01-01", "end_date": "2031-01-01", "km_limit": 150000}, "expected": {"status": "active", "expired_by": [], "expiring_soon_by": []}},
    {"name": "end date exactly 90 days away is expiring soon", "today": "2026-10-22", "current_odometer_km": null, "coverage": {"start_date": "2021-01-01", "end_date": "2027-01-20", "km_limit": null}, "expected": {"status": "expiring_soon", "expired_by": [], "expiring_soon_by": ["date"]}},
    {"name": "end date 91 days away is active", "today": "2026-10-22", "current_odometer_km": null, "coverage": {"start_date": "2021-01-01", "end_date": "2027-01-21", "km_limit": null}, "expected": {"status": "active", "expired_by": [], "expiring_soon_by": []}},
    {"name": "exactly 5000 km remaining is expiring soon", "today": "2026-10-22", "current_odometer_km": 145000, "coverage": {"start_date": "2026-01-01", "end_date": null, "km_limit": 150000}, "expected": {"status": "expiring_soon", "expired_by": [], "expiring_soon_by": ["odometer"]}},
    {"name": "5001 km remaining is active", "today": "2026-10-22", "current_odometer_km": 144999, "coverage": {"start_date": "2026-01-01", "end_date": null, "km_limit": 150000}, "expected": {"status": "active", "expired_by": [], "expiring_soon_by": []}},
    {"name": "future-start extended coverage is not started", "today": "2026-10-22", "current_odometer_km": 30000, "coverage": {"start_date": "2027-10-22", "end_date": "2030-10-22", "km_limit": 200000}, "expected": {"status": "not_started", "expired_by": [], "expiring_soon_by": []}},
    {"name": "factory coverage beside it is expired by date only", "today": "2026-10-22", "current_odometer_km": 30000, "coverage": {"start_date": "2021-01-01", "end_date": "2026-01-01", "km_limit": 150000}, "expected": {"status": "expired", "expired_by": ["date"], "expiring_soon_by": []}},
    {"name": "not started coverage already past its km limit is expired", "today": "2026-10-22", "current_odometer_km": 30000, "coverage": {"start_date": "2027-10-22", "end_date": "2030-10-22", "km_limit": 20000}, "expected": {"status": "expired", "expired_by": ["odometer"], "expiring_soon_by": []}}
  ]
}
