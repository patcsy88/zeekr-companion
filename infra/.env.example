# Copy to infra/.env (gitignored) and fill in the two secrets below. They are deliberately empty:
# Compose refuses to start while any is unset, and the API refuses placeholders and weak values.
# Never commit .env.

# Database password (any long random string; avoid '@', '/', ':' and '%' as it goes into a URL).
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# The owner's username and password are not set here. After the stack is up, create them once:
#   docker compose exec api python -m app.cli.set_owner
# The same command resets them later. They are stored in the database as a username and a scrypt hash.

# Secret used to sign access tokens, at least 32 characters and not a placeholder:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
TOKEN_SECRET=

# Comma-separated browser origins allowed to call the API. Default: none.
# Not needed when the web client is served same-origin through a reverse proxy.
CORS_ALLOWED_ORIGINS=

# Password checks the API runs at once. Each holds about 128 MiB. Default 2; allowed 1 to 4.
# Set 1 on a 512 MB host (for example a Raspberry Pi Zero 2 W): a burst of sign-ins then waits in
# line instead of running the API out of memory.
PASSWORD_HASH_CONCURRENCY=2

# The web proxy is the only published service. Loopback only by default; never 0.0.0.0 unless you
# deliberately put it behind a private interface.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080

# Release install only (infra/docker-compose.release.yml, ADR-012): the published image version to run,
# for example v0.1.0. Required there and ignored by docker-compose.yml. There is no "latest".
# ZEEKR_VERSION=

# The web client is built inside the web image, so there is nothing to build or copy by hand.
# (WEB_DIST_DIR is no longer used. A leftover line in an older .env is ignored.)

# Optional browser error reporting (ADR-007), read when the web image is built. Empty means off.
# Changing it needs: docker compose build web && docker compose up -d
VITE_SENTRY_DSN=

# Static network for the proxy. The API trusts X-Forwarded-For only from WEB_PROXY_IP (never '*').
# Change both together if 172.28.77.0/24 clashes with another Docker network.
# WEB_SUBNET=172.28.77.0/24
# WEB_PROXY_IP=172.28.77.10

# "on" adds Strict-Transport-Security. Leave "off" until the site is served over HTTPS.
WEB_HSTS=off

# Optional private HTTPS through the Tailscale sidecar (ADR-003, infra/README.md "Tailscale sidecar").
# Off unless COMPOSE_PROFILES=tailscale. TS_HOSTNAME must be neutral (no zeekr, name, plate or
# city): it is published in Certificate Transparency logs. TS_AUTHKEY is optional and a secret;
# leave it empty to log in once through the link in "docker compose logs tailscale".
# COMPOSE_PROFILES=tailscale
TS_HOSTNAME=
TS_AUTHKEY=

# Optional Sentry error reporting (ADR-007). Leave empty to send nothing. The DSN comes from the
# project's Settings > Client Keys page. Errors only: no request bodies, records or tokens.
SENTRY_DSN_API=

# Optional advisory explanations from a hosted model (ADR-008). Off unless ADVISORY_MODEL_ENABLED
# is true AND the key and model id are set. Only derived numbers and dates are sent; prompts and
# replies are logged on the host. Set the USD 10.00 monthly cap in the provider console first.
ADVISORY_MODEL_ENABLED=false
ADVISORY_MODEL_ID=
ADVISORY_MONTHLY_CALL_LIMIT=60
ANTHROPIC_API_KEY=
# Optional: an Anthropic-compatible endpoint instead of api.anthropic.com (for example a proxy on
# your own network). Give the address up to the host and port; a trailing /v1 is removed. With a
# proxy, ANTHROPIC_API_KEY is the proxy's key. Keep the real address in infra/.env only.
ADVISORY_MODEL_BASE_URL=

# Optional LangSmith tracing (free Developer plan, spend limit set, extended traces off). Content
# and metadata are stripped before sending, so only timing and status leave the host. The URL is
# the region endpoint from the LangSmith settings page. Leave off unless you want it.
ADVISORY_TRACING_ENABLED=false
ADVISORY_TRACING_API_KEY=
ADVISORY_TRACING_API_URL=

# Optional live Zeekr readings (ADR-009), read-only, from a SECOND Zeekr account the car is shared
# to, never your main one. Off unless ZEEKR_LIVE_ENABLED is true, and then every value below must
# be set or the API refuses to start. The Vehicle page's live card reads them. Real values live in
# infra/.env only; the app values come from the key extraction described in ADR-009.
ZEEKR_LIVE_ENABLED=false
# Minutes between real Zeekr reads, and between the Vehicle page's refreshes. Minimum 5; a lower
# value makes the API refuse to start. Change it by editing this file and restarting the API.
ZEEKR_LIVE_INTERVAL_MINUTES=5
# Seconds the Sentry button waits after sending before it reads the state back (ADR-010). 5 to 30;
# outside that range the API refuses to start. Edit this file and restart the API to change it.
SENTRY_CONFIRM_WAIT_SECONDS=15
ZEEKR_USERNAME=
ZEEKR_PASSWORD=
ZEEKR_COUNTRY_CODE=
ZEEKR_HMAC_ACCESS_KEY=
ZEEKR_HMAC_SECRET_KEY=
ZEEKR_PASSWORD_PUBLIC_KEY=
ZEEKR_PROD_SECRET=
ZEEKR_VIN_KEY=
ZEEKR_VIN_IV=

# Geofence alert (Piece B): an in-app notice when the car is parked outside your home area with
# Sentry off. Read-only; it never sends anything to the car. Needs ZEEKR_LIVE_ENABLED=true. Set
# GEOFENCE_HOME_QUERY (a street-level address, looked up once with public Nominatim) OR both
# GEOFENCE_HOME_LAT and GEOFENCE_HOME_LON (skips the lookup). Real values live in infra/.env only.
GEOFENCE_ENABLED=false
GEOFENCE_HOME_QUERY=
GEOFENCE_HOME_LAT=
GEOFENCE_HOME_LON=
GEOFENCE_RADIUS_KM=5
# Minutes between checks. Minimum 5.
GEOFENCE_INTERVAL_MINUTES=5
# A reading older than this many minutes changes nothing.
GEOFENCE_STALE_MINUTES=30
# Second lock for automatic Sentry on (ADR-011). The switch in the app does nothing unless this is
# true. Keep it false until the geofence alert has been proven on a real stay and you are ready
# to watch the first automatic send.
GEOFENCE_AUTO_SENTRY_ALLOWED=false
