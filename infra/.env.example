# Copy to infra/.env (gitignored) and fill in the two secrets below. They are deliberately empty:
# Compose refuses to start while any is unset, and the API refuses placeholders and weak values.
# Never commit .env.

# Database password (any long random string; avoid '@', '/', ':' and '%' as it goes into a URL).
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# The owner's username and password are not set here. After the stack is up, create them once:
#   docker compose exec api python -m app.cli.set_owner
# The same command resets them later. They are stored in the database as a username and a scrypt hash.

# Secret used to sign access tokens, at least 32 characters and not a placeholder:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
TOKEN_SECRET=

# Comma-separated browser origins allowed to call the API. Default: none.
# Not needed when the web client is served same-origin through a reverse proxy.
CORS_ALLOWED_ORIGINS=

# The web proxy is the only published service. Loopback only by default; never 0.0.0.0 unless you
# deliberately put it behind a private interface.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080

# Directory with the built web client (apps/web/dist after `npm run build`). Default is a placeholder.
# WEB_DIST_DIR=../apps/web/dist

# Static network for the proxy. The API trusts X-Forwarded-For only from WEB_PROXY_IP (never '*').
# Change both together if 172.28.77.0/24 clashes with another Docker network.
# WEB_SUBNET=172.28.77.0/24
# WEB_PROXY_IP=172.28.77.10

# "on" adds Strict-Transport-Security. Leave "off" until the site is served over HTTPS.
WEB_HSTS=off

# Optional Sentry error reporting (ADR-007). Leave empty to send nothing. The DSN comes from the
# project's Settings > Client Keys page. Errors only: no request bodies, records or tokens.
SENTRY_DSN_API=
